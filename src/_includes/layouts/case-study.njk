---
layout: base.njk
---
{% set workItems = collections.work_en if locale == "en" else collections.work_de %}
{% set nextItem = workItems[0] %}
{% for w in workItems %}{% if w.data.order == order + 1 %}{% set nextItem = w %}{% endif %}{% endfor %}

<header class="cs-bar">
  <div class="wrap">
    <a class="back" href="{{ homeUrl }}#work" data-mag>{{ strings.back }}</a>
    {% include "partials/lang.njk" %}
  </div>
</header>

<main class="tint-{{ order }}">
  <section class="cs-hero">
    <div class="wrap">
      <div class="tags" data-rv="up">{% for tg in tags %}<span class="tag">{{ tg }}</span>{% endfor %}</div>
      <div data-par="-0.04">
        <h1 class="disp cs-title" data-rv="words" aria-label="{{ title }}">{{ titleWords | wordSpans(true) | safe }}</h1>
      </div>
      <p class="lead" data-rv="up" style="--d: 2">{{ lead }}</p>
    </div>
  </section>

  <div class="cz" data-cz>
    <div class="cz-sticky">
      <div class="cz-fig" data-cz-fig>
        <img src="{{ cover }}" alt="{{ coverAlt }}" data-cz-img>
      </div>
    </div>
  </div>

  <section class="sec" style="padding-bottom: 0">
    <div class="wrap">
      <dl class="facts">
        <div data-rv="up" style="--d: 0"><dt>{{ strings.labelRole }}</dt><dd>{{ role }}</dd></div>
        <div data-rv="up" style="--d: 1"><dt>{{ strings.labelScope }}</dt><dd>{{ scope }}</dd></div>
        <div data-rv="up" style="--d: 2"><dt>{{ strings.labelTools }}</dt><dd>{{ tools }}</dd></div>
        <div data-rv="up" style="--d: 3"><dt>{{ strings.labelYear }}</dt><dd>{{ year }}</dd></div>
      </dl>
    </div>
  </section>

  <section class="sec" style="padding-bottom: 0">
    <div class="wrap">
      <div class="eyebrow" data-rv="up" style="margin-bottom: 24px">{{ strings.labelOutcomes }}</div>
      {% if metricsHeading %}<h2 class="mh" data-rv="up">{{ metricsHeading }}</h2>{% endif %}
      <div class="metrics">
        {% for m in metrics %}
        <div class="metric" data-rv="up" data-count style="--d: {{ loop.index0 }}">
          <div class="metric-v"><span class="cnt"><span class="cnt-real">{{ m.value }}</span><span class="cnt-anim" data-cnt-anim aria-hidden="true"></span></span></div>
          <div class="metric-l">{{ m.label }}</div>
        </div>
        {% endfor %}
      </div>
      {% if metricsNote %}<p class="metrics-note" data-rv="up">{{ metricsNote }}</p>{% endif %}
    </div>
  </section>

  <section class="sec" style="padding-bottom: 0">
    <div class="wrap">
      {% for b in blocks %}
      <div class="blk">
        <div class="eyebrow" data-rv="up" style="align-self: start">{{ b.label }}</div>
        <div data-rv="up" style="--d: 1">
          <h3 class="blk-h">{{ b.heading }}</h3>
          <div class="prose">
            {% for p in b.paras %}<p>{{ p }}</p>{% endfor %}
            {% if b.bullets %}<ul class="bul">{% for bl in b.bullets %}<li>{{ bl }}</li>{% endfor %}</ul>{% endif %}
            {% for p in b.after %}<p>{{ p }}</p>{% endfor %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="bigq">
    <div class="wrap">
      <figure data-rv="up">
        <div data-par="0.05"><blockquote>{{ strings.qo }}{{ insightQuote }}{{ strings.qc }}</blockquote></div>
        <cite>— {{ insightAttr }}</cite>
      </figure>
    </div>
  </section>

  <section class="sec" style="padding-top: 0">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom: 48px">
        <div class="eyebrow" data-rv="up">{{ prinLabel or strings.labelPrinciples }}</div>
        <h2 class="disp h2" style="font-size: clamp(40px, 5.4vw, 84px)" data-rv="up">{{ prinHeading }}</h2>
      </div>
      <div class="prin">
        {% for pr in principles %}
        <div class="prin-card" data-rv="up" style="--d: {{ loop.index0 }}">
          <div class="prin-n">{{ pr.number }}</div>
          <h3>{{ pr.title }}</h3>
          <p>{{ pr.body }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="sec" style="background: var(--alt); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line)">
    <div class="wrap proc">
      <div class="proc-side">
        <div class="eyebrow" style="margin-bottom: 22px">{{ strings.labelProcess }}</div>
        <h2 class="disp h2" data-rv="up">{{ procHeading }}</h2>
        <div class="proc-num" aria-hidden="true">{% for st in process %}<span data-pn>{{ st.number }}</span>{% endfor %}</div>
      </div>
      <ol class="steps">
        {% for st in process %}
        <li class="step" data-step>
          <span class="step-n">{{ st.number }}</span>
          <div><h3>{{ st.title }}</h3><p>{{ st.body }}</p></div>
        </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  {% for g in galleries %}
  <section class="sec gal" style="padding-bottom: 0">
    <div class="wrap">
      <div class="eyebrow" data-rv="up" style="margin-bottom: 24px">{{ g.label }}</div>
      <h2 class="mh" data-rv="up">{{ g.heading }}</h2>
      {% if g.intro %}<p class="gal-intro" data-rv="up">{{ g.intro }}</p>{% endif %}
    </div>
    {% if g.embed %}
    <div class="gal-embed" style="--h: {{ g.height }}px; --hm: {{ g.heightMobile }}px">
      <iframe src="{{ g.embed }}" title="{{ g.heading }}" loading="lazy" scrolling="no"></iframe>
    </div>
    {% endif %}
    {% if g.images %}
    <div class="wrap">
      <div class="gal-grid gal-grid--{{ g.columns }}">
        {% for im in g.images %}
        <figure class="gal-cell">
          <img src="{{ im.src }}" alt="{{ im.alt }}" loading="lazy">
          <figcaption><strong>{{ im.title }}</strong>{{ im.caption }}</figcaption>
        </figure>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </section>
  {% endfor %}

  {% if blocks2 %}
  <section class="sec" style="padding-bottom: 0">
    <div class="wrap">
      {% for b in blocks2 %}
      <div class="blk">
        <div class="eyebrow" data-rv="up" style="align-self: start">{{ b.label }}</div>
        <div data-rv="up" style="--d: 1">
          <h3 class="blk-h">{{ b.heading }}</h3>
          <div class="prose">
            {% for p in b.paras %}<p>{{ p }}</p>{% endfor %}
            {% if b.items %}
            <div class="sub-items">
              {% for si in b.items %}<div class="sub-item"><h4>{{ si.title }}</h4><p>{{ si.body }}</p></div>{% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if quotes %}
  <section class="sec" style="padding-bottom: 0">
    <div class="wrap">
      <div class="eyebrow" data-rv="up" style="margin-bottom: 40px">{{ strings.userQuotes }}</div>
      <div class="uq">
        {% for q in quotes %}
        <figure data-rv="up" style="--d: {{ loop.index0 }}">
          <blockquote>{{ strings.qo }}{{ q }}{{ strings.qc }}</blockquote>
          <figcaption>{{ strings.testUser }}</figcaption>
        </figure>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="sec">
    <div class="wrap">
      <div class="eyebrow" data-rv="up" style="margin-bottom: 36px">{{ strings.labelReflection }}</div>
      <p class="hl refl-pull" data-hl>{{ pull | hlSpans | safe }}</p>
      <div class="blk">
        <div class="eyebrow" data-rv="up" style="align-self: start">{{ strings.learnings }}</div>
        <div class="prose" data-rv="up" style="--d: 1">
          {% for p in reflection %}<p>{{ p }}</p>{% endfor %}
        </div>
      </div>
      {% if nextSteps %}
      <div class="blk">
        <div class="eyebrow" data-rv="up" style="align-self: start">{{ strings.labelNextSteps }}</div>
        <div class="prose" data-rv="up" style="--d: 1">
          {% for p in nextSteps %}<p>{{ p }}</p>{% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </section>

  <section class="next">
    <div data-rv="up">
      <a class="next-card" href="{{ nextItem.url }}" data-tilt data-curtain-label="{{ nextItem.data.title }}" aria-label="{{ strings.nextProjectLabel }}: {{ nextItem.data.title }}">
        <div class="next-body">
          <div class="eyebrow">{{ strings.nextProjectLabel }}</div>
          <div>
            <div class="disp next-title">{{ nextItem.data.titleWords | wordSpans(false) | safe }}</div>
            <p style="color: var(--on-dark2); font-size: 17px; margin-top: 18px; max-width: 460px">{{ nextItem.data.tagline }}</p>
          </div>
          <span class="arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
        </div>
        <div class="next-media"><div class="card-zoom"><img src="{{ nextItem.data.cover }}" alt="{{ nextItem.data.coverAlt }}" data-par="0.08" data-par-scale="1.18" loading="lazy"></div></div>
      </a>
    </div>
  </section>
</main>
